# Keylox Backend Proxy — contoh konfigurasi (TIDAK berisi rahasia nyata)
PORT=8787
# Default loopback: jangan bind ke 0.0.0.0 kecuali di belakang reverse proxy/container.
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# Gemini API key (SERVER-SIDE ONLY, never ship to client)
# Wajib diisi di production; backend menolak start tanpa JWT_SECRET di production.
# Sejak BYOK: ini HANYA fallback dev/testing. Di production klien wajib mengirim
# X-Provider-Key (mode PROXY) atau memakai mode DIRECT tanpa backend.
GEMINI_API_KEY=
# Model yang dipakai untuk SEMUA request di mode PROXY (dipilih server, bukan klien).
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_VERSION=1

# ---------- BYOK / proxy (byok-api-key.md §5.2, api-contract §3.7) ----------
# Header dari klien (mode PROXY):
#   X-Provider-Key       key MILIK USER. TLS-only, dilarang masuk log/telemetri
#                        (backend meredaksi pola key + hanya mencatat fingerprint 8 char).
#   X-Provider           'gemini' (default) | 'openai' (belum didukung -> ERR_PROVIDER_UNSUPPORTED).
#   X-Provider-Base-Url  opsional; HANYA host di allowlist provider yang diterima
#                        (anti-SSRF: tolak http non-localhost, rentang privat/link-local,
#                        endpoint metadata cloud, port/path non-default).
# true = X-Provider-Key WAJIB; fallback GEMINI_API_KEY dimatikan total.
BYOK_REQUIRE_USER_KEY=false
# Rate limit TAMBAHAN per hash(key) (selain per user/device/IP).
PROVIDER_KEY_RATE_LIMIT_MAX=30
PROVIDER_KEY_RATE_LIMIT_WINDOW_MS=60000
# Izinkan X-Provider-Key tanpa TLS HANYA dari loopback (dev lokal). Default: true di
# non-production, false di production.
ALLOW_INSECURE_PROVIDER_KEY_LOCALHOST=true
# Skenario mock KHUSUS TEST (hanya berlaku bila MOCK_AI=true):
# '' | destructive_no_confirm | unknown_optype | missing_plan
MOCK_AI_SCENARIO=

# Auth / JWT
# WaJIB: string acak >= 32 karakter. Tidak ada nilai default di kode (fail-fast).
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Rate limit (per user JWT / per IP)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
DAILY_QUOTA=1000

# CORS allowlist (koma). Klien desktop tanpa Origin / Origin "null" tetap diizinkan
# kecuali ALLOW_NULL_ORIGIN=false.
ALLOWED_ORIGINS=
ALLOW_NULL_ORIGIN=true

# Set true HANYA bila di belakang reverse proxy tepercaya (X-Forwarded-For).
TRUST_PROXY=false

# Cache
CACHE_TTL_MS=2592000000
CACHE_MAX_ENTRIES=5000

# Redis (optional) for BullMQ queue
REDIS_URL=

# Telemetry opt-out handled client-side; backend logs no PII
TELEMETRY_ENABLED=false

# Mock AI (dev/testing, tanpa key & tanpa jaringan):
#   true  -> /ai/* mengembalikan EditPlan mock; gate kuota/rate limit tetap berjalan
#   false -> panggilan provider nyata (butuh GEMINI_API_KEY atau X-Provider-Key)
# Default bila baris ini dihapus: false.
MOCK_AI=false

